# ====================================================================
# SIH26034 - Legal Metrology Compliance Verification System
# Environment Configuration Template
# ====================================================================

# Server Configuration
PORT=5050
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/legal_metrology_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_32chars_min
JWT_EXPIRES_IN=7d

# OCR / Vision Service Provider (options: mock | google_vision | tesseract | gemini)
OCR_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rule Engine Configuration
RULE_ENGINE_VERSION=2011.1
STRICT_MODE=true
